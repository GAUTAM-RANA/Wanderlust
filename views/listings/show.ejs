
<% layout("/layouts/boilerplate") %>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
</script>

<!-- Listing Details -->

<div class="row mt-3">

    <div class="col-8 offset-2">

        <h3>Listing Details</h3>

    </div>


    <!-- Listing Card -->

    <div class="card col-6 offset-2 listing-card">

        <img
            src="<%= listing.image.url %>"
            class="card-img-top show-img"
            alt="listing-image"
        />

        <div class="card-body">

            <p class="card-text">
                Owned by
                <i><%= listing.owner.username %></i>
            </p>

            <p class="card-text">
                <%= listing.title %>
            </p>

            <p class="card-text">
                <%= listing.description %>
            </p>

            <p class="card-text">
                ₹ <%= listing.price.toLocaleString("en-IN") %>
            </p>

            <p class="card-text">
                <%= listing.location %>
            </p>

            <p class="card-text">
                <%= listing.country %>
            </p>

        </div>

    </div>


    <!-- Edit and Delete Listing -->

    <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>

        <div class="col-8 offset-2 mt-3">

            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-dark"
            >
                Edit this Listing
            </a>

            <br><br>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
            >

                <button class="btn btn-danger">
                    Delete this Listing
                </button>

            </form>

        </div>

    <% } %>


    <!-- Review Section -->

    <div class="col-8 offset-2 mt-3">

        <% if(currentUser) { %>
            <hr/>
            <h4>Leave a Review</h4>

            <form
                action="/listings/<%= listing._id %>/reviews"
                method="POST"
            >

                <!-- Star Rating -->

                <div class="mb-3 mt-3">

                    <label class="form-label">
                        Rating
                    </label>

                    <fieldset class="star-rating">

                        <input
                            type="radio"
                            id="rating1"
                            name="review[rating]"
                            value="1"
                            required
                        >

                        <label for="rating1" title="1 star">
                            ★
                        </label>


                        <input
                            type="radio"
                            id="rating2"
                            name="review[rating]"
                            value="2"
                        >

                        <label for="rating2" title="2 stars">
                            ★
                        </label>


                        <input
                            type="radio"
                            id="rating3"
                            name="review[rating]"
                            value="3"
                        >

                        <label for="rating3" title="3 stars">
                            ★
                        </label>


                        <input
                            type="radio"
                            id="rating4"
                            name="review[rating]"
                            value="4"
                        >

                        <label for="rating4" title="4 stars">
                            ★
                        </label>


                        <input
                            type="radio"
                            id="rating5"
                            name="review[rating]"
                            value="5"
                        >

                        <label for="rating5" title="5 stars">
                            ★
                        </label>

                    </fieldset>

                </div>


                <!-- Review Comment -->

                <div class="mb-3 mt-3">

                    <label for="comment" class="form-label">
                        Comment
                    </label>

                    <textarea
                        name="review[comment]"
                        id="comment"
                        cols="10"
                        rows="4"
                        class="form-control"
                        required
                    ></textarea>

                </div>


                <!-- Submit Review -->

                <button class="btn btn-primary">
                    Submit Review
                </button>

            </form>

     


        <hr>
      <% } %>

       <% if(listing.reviews.length > 0)  { %>


        <div class="row">
             <p><b>All Reviews</b></p>
            <% for(review of listing.reviews) { %>

                <div class="card col-6 mb-3">

                    <div class="card-body">

                        <!-- Review Author -->

                        <h5 class="card-title">

                            @<%= review.author.username %>

                        </h5>


                        <!-- Review Comment -->

                        <p class="card-text">

                            <%= review.comment %>

                        </p>


                        <!-- Review Star Rating -->

                        <p class="card-text review-stars">

                            <% for(let i = 1; i <= 5; i++) { %>

                                <% if(i <= review.rating) { %>

                                    <span class="filled-star">
                                        ★
                                    </span>

                                <% } else { %>

                                    <span class="empty-star">
                                        ☆
                                    </span>

                                <% } %>

                            <% } %>

                        </p>

                    </div>


                    <!-- Delete Review -->

                    <% if(currentUser && review.author._id.equals(currentUser._id)) { %>

                        <form
                            class="mb-3"
                            method="POST"
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                        >

                            <button class="btn btn-sm btn-dark">
                                Delete
                            </button>

                        </form>

                    <% } %>

                </div>

            <% } %>

        </div>
       <% } %>      
 
    </div>
    <div class="col-6 offset-2 mt-3">
          <h3>Where you'll be staying</h3>
          <div id="map"></div>
        </div>

</div>

<script src="/js/map.js"></script>
