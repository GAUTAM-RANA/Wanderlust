
<% layout("layouts/boilerplate") %>

<%= success %>

<style>
    /* FILTER SECTION */

    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
        padding: 10px 0;
    }

    .filter {
        text-align: center;
        min-width: 65px;
        opacity: 0.7;
        cursor: pointer;
    }

    .filter:hover {
        opacity: 1;
    }

    .filter i {
        font-size: 1.3rem;
    }

    .filter p {
        font-size: 0.8rem;
        margin: 5px 0 0;
    }

    /* TAX TOGGLE */

    .tax-toggle {
        border: 1px solid #222;
        border-radius: 1rem;
        padding: 10px 15px;
        display: flex;
        align-items: center;
        margin-left: auto;
    }

    .tax-toggle .form-check {
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tax-info {
        display: none;
    }

    /* LISTING CARDS */

    .listing-card {
        border: none !important;
        margin-bottom: 1rem;
        width: 100%;
        height: 100%;
    }

    .listing-card .card-img-top {
        width: 100%;
        height: 250px;
        object-fit: cover;
        border-radius: 1rem;
    }

    .listing-card .card-body {
        padding: 10px 0 !important;
    }

    .listing-link {
        text-decoration: none;
        color: #222;
        display: block;
        height: 100%;
    }

    .listing-link:hover {
        color: #222;
    }

    .card-text {
        line-height: 1.6;
        overflow-wrap: break-word;
    }

    /* MOBILE RESPONSIVENESS */

    @media (max-width: 768px) {

        #filters {
            gap: 1.2rem;
            justify-content: flex-start;
        }

        .filter {
            min-width: 65px;
        }

        .tax-toggle {
            margin-left: 0;
            width: 100%;
            justify-content: center;
        }

        .listing-card .card-img-top {
            height: 230px;
        }
    }

    @media (max-width: 480px) {

        #filters {
            gap: 1rem;
        }

        .filter {
            min-width: 60px;
        }

        .filter p {
            font-size: 0.75rem;
        }

        .listing-card .card-img-top {
            height: 220px;
        }

        .card-text {
            font-size: 14px;
        }
    }
</style>


<!-- FILTERS -->

<div id="filters">

    <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-swimmer"></i></div>
        <p>Amazing pools</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-city"></i></div>
        <p>Iconic cities</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </div>

    <!-- TAX SWITCH -->

    <div class="tax-toggle">

        <div class="form-check form-switch">

            <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="flexSwitchCheckDefault"
            >

            <label
                class="form-check-label"
                for="flexSwitchCheckDefault"
            >
                Display taxes
            </label>

        </div>

    </div>

</div>


<!-- LISTINGS -->

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 mt-3 g-4">

    <% for(let listing of allListings) { %>

        <div class="col">

            <a
                href="/listings/<%= listing._id %>"
                class="listing-link"
            >

                <div class="card listing-card">

                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top"
                        alt="<%= listing.title %>"
                    >

                    <div class="card-body">

                        <p class="card-text">

                            <b><%= listing.title %></b>

                            <br>

                            &#8377;<%= listing.price.toLocaleString("en-IN") %>/night

                            <i class="tax-info">
                                &nbsp; +18% GST
                            </i>

                        </p>

                    </div>

                </div>

            </a>

        </div>

    <% } %>

</div>


<!-- TAX SWITCH JAVASCRIPT -->

<script>

    const taxSwitch = document.getElementById(
        "flexSwitchCheckDefault"
    );

    const taxInfo = document.querySelectorAll(".tax-info");

    taxSwitch.addEventListener("change", () => {

        taxInfo.forEach((info) => {

            info.style.display = taxSwitch.checked
                ? "inline"
                : "none";

        });

    });

</script>
